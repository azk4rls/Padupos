# ================================================================
# PADUPOS — Environment Configuration Template
# ================================================================

# --- APP CONFIGURATION ---
APP_ENV=development
APP_PORT=4000
APP_HOST=0.0.0.0
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DEFAULT_COUNTRY_CODE=ID
DEFAULT_LOCALE=id-ID
DEFAULT_TIMEZONE=Asia/Jakarta

# --- SUPABASE / POSTGRESQL DATABASE ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- PAYMENT PROVIDER (SANDBOX FIRST) ---
# Supported providers: XENDIT, MIDTRANS, MOCK_SANDBOX (dev/test only)
PAYMENT_PROVIDER=XENDIT
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_API_KEY=xnd_development_your_api_key
PAYMENT_WEBHOOK_SECRET=your_webhook_verification_token
PAYMENT_WEBHOOK_TOKEN=your_callback_verification_token

# --- AI INSIGHT CONFIGURATION ---
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
AI_INSIGHT_CACHE_HOURS=24

# --- ML WORKER CONFIGURATION ---
ML_SERVICE_URL=http://localhost:8000
ML_MODEL_PATH=./workers/ml/models
ML_MODEL_VERSION=1.0.0
ML_MIN_TRANSACTIONS_THRESHOLD=30

# --- OBSERVABILITY & LOGGING ---
LOG_LEVEL=info
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development

# --- SECURITY & ENCRYPTION ---
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
